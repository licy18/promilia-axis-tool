{
  "name": "promilia-axis-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit:production-imports": "node scripts/audit-production-imports.mjs",
    "audit:production-imports:check": "node scripts/audit-production-imports.mjs --assert-clean",
    "audit:bundle": "node scripts/audit-build-bundle.mjs",
    "audit:bundle:check": "node scripts/audit-build-bundle.mjs --assert-budget",
    "audit:action-status": "node scripts/generate-action-status-catalog.mjs",
    "audit:action-status:check": "node scripts/generate-action-status-catalog.mjs --assert-clean",
    "audit:applied-source-bindings": "node scripts/audit-applied-source-bindings.mjs",
    "audit:applied-source-bindings:check": "node scripts/audit-applied-source-bindings.mjs --assert-clean",
    "audit:workbench-data": "node scripts/audit-workbench-production-data.mjs",
    "audit:workbench-data:check": "node scripts/audit-workbench-production-data.mjs --assert-clean",
    "benchmark:long-axis": "node --expose-gc scripts/benchmark-workbench-long-axis.mjs",
    "benchmark:long-axis:check": "node --expose-gc scripts/benchmark-workbench-long-axis.mjs --assert-budget",
    "benchmark:long-axis:browser": "playwright test e2e/workbench-long-axis.spec.js -g @workbench-long-axis",
    "benchmark:long-axis:comparison": "playwright test e2e/workbench-long-axis-comparison.spec.js -g @workbench-comparison-long-axis",
    "benchmark:machine-axis-batch": "node --expose-gc scripts/benchmark-machine-axis-batch.mjs",
    "benchmark:machine-axis-search": "node --expose-gc scripts/benchmark-machine-axis-search.mjs",
    "data:generate": "node scripts/generate-azpr-data.mjs && node scripts/generate-action-status-catalog.mjs --write",
    "data:sync-verified-combat": "node scripts/sync-verified-combat-mechanics.mjs --write",
    "data:refresh-reports": "node scripts/refresh-derived-reports.mjs",
    "data:refresh-reports:full": "node scripts/refresh-derived-reports.mjs --full",
    "db:export": "node scripts/database-tool.mjs export",
    "db:hash": "node scripts/database-tool.mjs hash",
    "db:validate": "node scripts/database-tool.mjs validate",
    "audit:verified-combat": "node scripts/sync-verified-combat-mechanics.mjs --assert-clean",
    "data:sync-character-combat": "node scripts/sync-character-combat-profile.mjs --write",
    "audit:character-combat": "node scripts/sync-character-combat-profile.mjs --all --assert-clean",
    "data:generate-character-acceptance": "node scripts/generate-character-acceptance.mjs --write",
    "audit:character-acceptance": "node scripts/generate-character-acceptance.mjs --assert-clean",
    "data:generate-optimization-scenario-policy": "node scripts/generate-optimization-scenario-policy.mjs --write",
    "audit:optimization-scenario-policy": "node scripts/generate-optimization-scenario-policy.mjs --assert-clean",
    "data:generate-optimization-qualification": "node scripts/generate-optimization-qualification.mjs --write",
    "audit:optimization-qualification": "node scripts/generate-optimization-qualification.mjs --assert-clean",
    "data:generate-binding-matrix": "node scripts/generate-m12-b3-binding-matrix.mjs --write",
    "audit:binding-matrix": "node scripts/generate-m12-b3-binding-matrix.mjs --assert-clean",
    "data:generate-visual-acceptance": "node scripts/generate-m12-b3-visual-acceptance.mjs --write",
    "audit:visual-acceptance": "node scripts/generate-m12-b3-visual-acceptance.mjs --assert-clean",
    "data:sync-action-icons": "node scripts/sync-workbench-action-icons.mjs",
    "data:sync-loadout-icons": "node scripts/sync-workbench-loadout-icons.mjs",
    "data:generate-runtime-capture-manifest": "node scripts/generate-runtime-capture-hook-manifest.mjs",
    "audit:runtime-capture-manifest": "node scripts/generate-runtime-capture-hook-manifest.mjs --assert-clean",
    "data:generate-machine-axis-enemy-settlement-evidence": "node scripts/generate-machine-axis-enemy-settlement-evidence.mjs",
    "audit:machine-axis-enemy-settlement-evidence": "node scripts/generate-machine-axis-enemy-settlement-evidence.mjs --assert-clean",
    "runtime-capture:capture": "python scripts/capture-azpr-runtime.py",
    "runtime-capture:preflight": "python scripts/capture-azpr-runtime.py --preflight",
    "runtime-capture:plan": "node scripts/prepare-runtime-capture-plan.mjs",
    "runtime-capture:normalize": "node scripts/normalize-runtime-capture.mjs",
    "runtime-capture:self-test": "python scripts/capture-azpr-runtime.py --self-test",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:full": "vitest run",
    "test:smart": "node scripts/run-smart-gates.mjs",
    "test:changed": "vitest run --changed",
    "test:core": "vitest run --project core",
    "test:dom": "vitest run --project dom",
    "test:e2e": "playwright test",
    "test:e2e:production-preview": "npm run audit:applied-source-bindings:check && npm run build && playwright test --config playwright.production.config.js",
    "test:e2e:workbench-performance": "npm run build && playwright test --config playwright.performance.config.js",
    "test:e2e:workbench-flow": "playwright test e2e/workbench-continuous-edit.spec.js -g @workbench-main-flow",
    "test:trial-release": "npm run test -- --run && npm run db:validate && npm run audit:runtime-capture-manifest && npm run audit:production-imports:check && npm run audit:workbench-data:check && npm run audit:action-status:check && npm run audit:verified-combat && npm run audit:optimization-scenario-policy && npm run audit:character-acceptance && npm run audit:optimization-qualification && npm run audit:bundle:check && npm run test:e2e:production-preview && git diff --check",
    "release:verify": "node scripts/release-verify.mjs",
    "test:coverage": "vitest run --coverage",
    "machine-axis": "node scripts/run-machine-axis-cli.mjs",
    "search:ai-guided": "node scripts/run-ai-guided-search.mjs",
    "search:ai-local": "node scripts/run-ai-local-search.mjs",
    "machine-axis:build": "vite build --config vite.machine-axis-cli.config.js",
    "data:sync-kibo-headless": "node scripts/generate-kibo-headless-census.mjs --write",
    "audit:kibo-headless": "node scripts/generate-kibo-headless-census.mjs --assert-clean",
    "audit:package:m11-headless": "node scripts/build-m11-headless-audit-package.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@zumer/snapdom": "^2.15.0",
    "echarts": "^5.5.0",
    "element-plus": "^2.9.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "3.5.30",
    "@vue/test-utils": "^2.4.6",
    "es-module-lexer": "2.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.3.3",
    "sass": "^1.98.0",
    "terser": "^5.49.0",
    "vite": "^6.0.1",
    "vitest": "^4.1.1"
  },
  "description": "蓝色星原战斗排轴编辑器",
  "author": "SOLO全栈开发",
  "license": "MIT"
}
