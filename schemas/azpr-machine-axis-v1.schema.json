{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azpr.local/schemas/azpr-machine-axis-v1.schema.json",
  "title": "Azur Promilia Machine Axis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractName",
    "dataIdentity",
    "scenario",
    "actions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractName": { "const": "AzPrMachineAxis" },
    "kind": { "const": "azpr-machine-axis" },
    "dataIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedMechanicsPackageId",
        "verifiedMechanicsPackageHash",
        "mechanicsProfileId"
      ],
      "properties": {
        "verifiedMechanicsPackageId": { "type": "string", "minLength": 1 },
        "verifiedMechanicsPackageHash": { "type": "string", "minLength": 1 },
        "mechanicsProfileId": { "type": "string", "minLength": 1 },
        "mechanicsProfileVersion": {
          "type": ["string", "number", "null"]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fps",
        "durationFrames",
        "team",
        "enemy",
        "initialRuntimeState",
        "projectile",
        "critical"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fps": { "const": 60 },
        "durationFrames": { "type": "integer", "minimum": 1 },
        "team": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/teamSlot" }
        },
        "enemy": { "$ref": "#/$defs/enemy" },
        "initialRuntimeState": { "type": "object" },
        "projectile": { "$ref": "#/$defs/projectile" },
        "critical": { "$ref": "#/$defs/critical" },
        "pickups": { "$ref": "#/$defs/pickupPolicy" },
        "target": { "$ref": "#/$defs/targetPolicy" },
        "optimizationQualification": {
          "$ref": "#/$defs/optimizationQualification"
        },
        "optimizationScenarioPolicy": {
          "$ref": "#/$defs/optimizationScenarioPolicyBinding"
        },
        "objectiveContract": { "$ref": "#/$defs/objectiveContract" },
        "jointAttackRuntime": { "type": "object" },
        "cultivationProfile": { "$ref": "#/$defs/cultivationProfile" }
      }
    },
    "actions": {
      "type": "array",
      "description": "Semantic action intents in explicit source sequence. When client evidence does not define the order of simultaneous cross-owner inputs, array order is the scenario-authored order; action ids are identities only and never ordering tiebreakers.",
      "items": { "$ref": "#/$defs/action" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "teamSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "characterId"],
      "properties": {
        "slotId": { "type": "string", "minLength": 1 },
        "characterId": { "type": "integer", "minimum": 1 },
        "level": { "type": ["integer", "null"], "minimum": 1 },
        "initialSp": { "type": ["number", "null"] },
        "loadout": { "type": "object" },
        "cultivation": { "type": "object" }
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enemyId"],
      "properties": {
        "enemyId": { "type": "integer", "minimum": 1 },
        "level": { "type": ["integer", "null"], "minimum": 1 },
        "hpMultiplier": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "defenseMultiplier": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "toughnessMultiplier": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "initialToughnessRatio": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "elementDefenseOverrides": { "type": "object" },
        "profile": { "$ref": "#/$defs/enemyProfile" }
      }
    },
    "enemyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractName",
        "profileId",
        "profileHash",
        "enemyId",
        "level",
        "source",
        "attributes",
        "breakRules"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractName": { "const": "AzPrEnemyProfile" },
        "profileId": { "type": "string", "minLength": 1 },
        "profileHash": { "type": "string", "minLength": 1 },
        "enemyId": { "type": "integer", "minimum": 1 },
        "level": { "type": "integer", "minimum": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "kind", "identity", "hash"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "identity": { "type": "string", "minLength": 1 },
            "hash": { "type": "string", "minLength": 1 }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxHp",
            "physicalDefense",
            "magicalDefense",
            "maxToughness",
            "elementDefenses"
          ],
          "properties": {
            "maxHp": { "type": "number", "exclusiveMinimum": 0 },
            "physicalDefense": { "type": "number", "minimum": 0 },
            "magicalDefense": { "type": "number", "minimum": 0 },
            "maxToughness": { "type": "number", "exclusiveMinimum": 0 },
            "elementDefenses": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          }
        },
        "breakRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recoveryDelayMs",
            "recoveryRateBasisPoints",
            "breakTimeMs",
            "breakEndTimeMs",
            "breakDamageUpBasisPoints",
            "typeMultipliersBasisPoints",
            "elementMultipliersBasisPoints"
          ],
          "properties": {
            "recoveryDelayMs": { "type": "number", "minimum": 0 },
            "recoveryRateBasisPoints": { "type": "number", "minimum": 0 },
            "breakTimeMs": { "type": "number", "exclusiveMinimum": 0 },
            "breakEndTimeMs": { "type": "number", "minimum": 0 },
            "breakDamageUpBasisPoints": { "type": "number", "minimum": 0 },
            "weaknessDamageMaximum": {
              "anyOf": [
                { "type": "number", "const": -1 },
                { "type": "number", "exclusiveMinimum": 0 },
                { "type": "null" }
              ]
            },
            "weaknessDamageMinimum": {
              "anyOf": [
                { "type": "number", "const": -1 },
                { "type": "number", "minimum": 0 },
                { "type": "null" }
              ]
            },
            "typeMultipliersBasisPoints": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            },
            "elementMultipliersBasisPoints": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          }
        }
      }
    },
    "objectiveContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractName",
        "objectiveId",
        "classification",
        "formalEligible",
        "targetPolicy",
        "scoring",
        "proofRequirements",
        "objectiveHash"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractName": { "const": "AzPrMachineAxisObjectiveContract" },
        "objectiveId": {
          "enum": [
            "cycle-dps-no-toughness",
            "cycle-dps-with-toughness",
            "fastest-kill",
            "damage",
            "burst",
            "toughness"
          ]
        },
        "classification": { "enum": ["primary", "legacy-diagnostic"] },
        "formalEligible": { "type": "boolean" },
        "targetPolicy": {
          "anyOf": [{ "$ref": "#/$defs/targetPolicy" }, { "type": "null" }]
        },
        "scoring": { "type": "object" },
        "proofRequirements": { "type": "object" },
        "objectiveHash": { "type": "string", "minLength": 1 }
      }
    },
    "critical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "enum": ["sampled", "expected", "critical", "non-critical"]
        },
        "seed": { "type": ["string", "integer", "null"] }
      }
    },
    "projectile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetDistance", "defaultWillHit"],
      "properties": {
        "targetDistance": { "type": "number", "minimum": 0 },
        "defaultWillHit": { "type": "boolean" }
      }
    },
    "pickupPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "policyHash",
        "autoCollect",
        "movementPolicy",
        "collectionPolicy",
        "sameFrameSpawnPolicy",
        "sameFrameExpiryPolicy"
      ],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "policyHash": { "type": "string", "minLength": 1 },
        "autoCollect": { "type": "boolean" },
        "movementPolicy": {
          "enum": ["no-implicit-movement", "explicit-scenario-movement"]
        },
        "collectionPolicy": {
          "enum": ["owner-source-action-absorb-only", "explicit-collision"]
        },
        "sameFrameSpawnPolicy": {
          "enum": ["exclude-same-frame-fail-closed", "include-same-frame"]
        },
        "sameFrameExpiryPolicy": { "const": "expire-before-absorb" },
        "distance": { "type": "number", "minimum": 0 }
      }
    },
    "targetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hpMode", "toughnessMode", "breakMode", "deathTruncation"],
      "properties": {
        "hpMode": { "enum": ["finite", "infinite"] },
        "toughnessMode": { "enum": ["enabled", "disabled"] },
        "breakMode": { "enum": ["enabled", "disabled"] },
        "deathTruncation": { "enum": ["enabled", "disabled"] }
      }
    },
    "optimizationQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["research", "formal"] },
        "catalogHash": { "type": ["string", "null"] }
      }
    },
    "optimizationScenarioPolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyHash", "rosterPolicyId", "rosterHash"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "policyHash": { "type": "string", "minLength": 1 },
        "rosterPolicyId": { "type": "string", "minLength": 1 },
        "rosterHash": { "type": "string", "minLength": 1 }
      }
    },
    "cultivationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractName", "profileId", "actors"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractName": { "const": "AzPrOptimizationCultivationProfile" },
        "profileId": { "type": "string", "minLength": 1 },
        "actors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/cultivationActor" }
        }
      }
    },
    "cultivationActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "character", "kibo", "soulEssence", "equipment"],
      "properties": {
        "slotId": { "type": "string", "minLength": 1 },
        "character": { "$ref": "#/$defs/characterCultivation" },
        "kibo": { "$ref": "#/$defs/kiboCultivation" },
        "soulEssence": { "$ref": "#/$defs/soulEssenceCultivation" },
        "equipment": { "$ref": "#/$defs/equipmentCultivation" }
      }
    },
    "characterCultivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "starGiftRank", "starGiftNodeIds"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "starGiftRank": { "type": "integer", "minimum": 0, "maximum": 7 },
        "starGiftNodeIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "levelBreakthroughRank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "kiboCultivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "talents", "bondLevel"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "talents": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/kiboTalent" }
        },
        "dnaFactors": {
          "type": "array",
          "maxItems": 0
        },
        "bondLevel": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "kiboTalent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributeId", "level"],
      "properties": {
        "attributeId": { "enum": [1, 3, 4, 5] },
        "level": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "soulEssenceCultivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rank", "star"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "rank": { "type": "integer", "minimum": 1, "maximum": 6 },
        "star": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "equipmentCultivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weapon", "top", "bottom", "earring", "ring"],
      "properties": {
        "weapon": { "$ref": "#/$defs/equipmentSlotCultivation" },
        "top": { "$ref": "#/$defs/equipmentSlotCultivation" },
        "bottom": { "$ref": "#/$defs/equipmentSlotCultivation" },
        "earring": { "$ref": "#/$defs/equipmentSlotCultivation" },
        "ring": { "$ref": "#/$defs/equipmentSlotCultivation" }
      }
    },
    "equipmentSlotCultivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rarity",
        "enhancementLevel",
        "tuningScore",
        "instanceTier",
        "maxValue"
      ],
      "properties": {
        "rarity": { "type": "integer", "minimum": 1, "maximum": 4 },
        "enhancementLevel": { "type": "integer", "minimum": 0, "maximum": 9 },
        "tuningScore": { "type": "integer", "minimum": 0, "maximum": 110 },
        "instanceTier": { "enum": ["normal", "starborn"] },
        "maxValue": { "type": "integer", "minimum": 0, "maximum": 110 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "intent", "schedule"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/owner" },
        "intent": { "$ref": "#/$defs/intent" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "hitOverrides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/hitOverride" }
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["actor", "kibo", "enemy", "system"] },
        "slotId": { "type": ["string", "null"] }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["public-action", "switch", "wait"] },
        "publicActionId": { "type": ["integer", "null"], "minimum": 1 },
        "actionKind": { "type": ["string", "null"] },
        "targetSlotId": { "type": ["string", "null"] },
        "durationFrames": { "type": ["integer", "null"], "minimum": 0 },
        "level": { "type": ["integer", "null"], "minimum": 1 },
        "semanticVariant": {
          "anyOf": [{ "$ref": "#/$defs/semanticVariant" }, { "type": "null" }]
        },
        "attackInput": {
          "anyOf": [{ "$ref": "#/$defs/attackInput" }, { "type": "null" }]
        }
      }
    },
    "semanticVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectorIdentity": { "type": ["string", "null"] },
        "selectorKind": { "type": ["string", "null"] },
        "publicVariantIndex": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "chargeTier": { "type": ["integer", "null"], "minimum": 1 },
        "inputFrame": { "type": ["integer", "null"], "minimum": 0 },
        "mode": { "enum": ["press", "hold", "release", null] }
      }
    },
    "attackInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequenceIndex"],
      "properties": {
        "sequenceIndex": { "type": "integer", "minimum": 1 },
        "groupId": { "type": ["string", "null"] },
        "contextActionId": { "type": ["string", "null"] },
        "chainIdentity": { "type": ["string", "null"] }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["absolute", "after-previous-end", "after-action-end"]
        },
        "frame": { "type": ["integer", "null"], "minimum": 0 },
        "actionId": { "type": ["string", "null"] },
        "offsetFrames": { "type": "integer" }
      }
    },
    "hitOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "landed": { "enum": ["inherit", "hit", "miss", "blocked"] },
        "criticalMode": {
          "enum": ["inherit", "sampled", "expected", "critical", "non-critical"]
        },
        "criticalRoll": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9999
        }
      }
    }
  }
}
